rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function noAdminAssigned() {
      return !exists(/databases/$(database)/documents/meta/app)
        || get(/databases/$(database)/documents/meta/app).data.adminAssigned != true;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && (request.resource.data.role == 'member'
            || (request.resource.data.role == 'admin' && noAdminAssigned()));
      allow update, delete: if isAdmin();
    }

    match /meta/{docId} {
      allow read: if signedIn();
      allow write: if noAdminAssigned() || isAdmin();
    }

    // ===== TEAM MODE: BharatCodex team ke saare members =====
    match /projects/{projectId} {
      // Sab signed-in members: sab projects dekhen, create karein, edit karein, trash karein
      allow read, create, update: if signedIn();
      // NOTE: delete permission hi nahi hai — permanent delete IMPOSSIBLE hai
      // (sirf files/folders subcollection mein delete allowed hai)

      match /files/{fileId} {
        allow read, write: if signedIn();
      }

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
